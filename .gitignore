data/videos/
*.mp4
*.mov
*.avi
*.mkv
# Model weights (M2+)
weights/
*.pt
*.pth
*.ckpt
*.onnx
# Generated reports
outputs/*
!outputs/.gitkeep

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

